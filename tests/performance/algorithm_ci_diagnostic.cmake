cmake_minimum_required(VERSION 3.28)
include_guard(GLOBAL)

function(vss_algorithm_ci_diagnostic_classify_capture token out_ok out_reason)
  if(token STREQUAL "capture_pass")
    set("${out_ok}" TRUE PARENT_SCOPE)
    set("${out_reason}" "" PARENT_SCOPE)
    return()
  endif()
  if(token MATCHES "^(allocation_inconsistent|invalid_record|qualification_incomplete)$")
    set("${out_ok}" FALSE PARENT_SCOPE)
    set("${out_reason}" "capture failed with ${token}" PARENT_SCOPE)
    return()
  endif()
  set("${out_ok}" FALSE PARENT_SCOPE)
  set("${out_reason}" "unknown capture token '${token}'" PARENT_SCOPE)
endfunction()

function(vss_algorithm_ci_diagnostic_classify_comparison token out_result
    out_ok out_reason)
  if(token STREQUAL "compatible_pass")
    set("${out_result}" diagnostic_comparison_pass PARENT_SCOPE)
    set("${out_ok}" TRUE PARENT_SCOPE)
    set("${out_reason}" "comparison stayed within the reviewed limit" PARENT_SCOPE)
  elseif(token MATCHES "^(incompatible|timing_regression|unstable_measurement)$")
    set("${out_result}" diagnostic_inconclusive PARENT_SCOPE)
    set("${out_ok}" TRUE PARENT_SCOPE)
    set("${out_reason}" "${token} is diagnostic only and is not qualification evidence" PARENT_SCOPE)
  else()
    set("${out_result}" diagnostic_failure PARENT_SCOPE)
    set("${out_ok}" FALSE PARENT_SCOPE)
    if(token MATCHES "^(allocation_regression|invalid_record|allocation_inconsistent|qualification_incomplete)$")
      set("${out_reason}" "comparison failed with ${token}" PARENT_SCOPE)
    else()
      set("${out_reason}" "unknown comparison token '${token}'" PARENT_SCOPE)
    endif()
  endif()
endfunction()
