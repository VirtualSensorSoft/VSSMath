function(vss_host_path relative out)
  if("${VSS_PERF_HOST_ROOT}" STREQUAL "/")
    set(value "/${relative}")
  else()
    set(value "${VSS_PERF_HOST_ROOT}/${relative}")
  endif()
  set("${out}" "${value}" PARENT_SCOPE)
endfunction()
function(vss_read path out_ok out_value)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    set("${out_ok}" FALSE PARENT_SCOPE)
    set("${out_value}" "" PARENT_SCOPE)
    return()
  endif()
  file(READ "${path}" value)
  string(STRIP "${value}" value)
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_value}" "${value}" PARENT_SCOPE)
endfunction()

