vss_host_path("sys/class/thermal" thermal_root)
file(GLOB thermal_zones LIST_DIRECTORIES true "${thermal_root}/thermal_zone*")
set(package_zones)
if("${VSS_PERF_HOST_ROOT}" STREQUAL "/")
  set(thermal_sys_prefix "/sys/")
else()
  set(thermal_sys_prefix "${VSS_PERF_HOST_ROOT}/sys/")
endif()
foreach(zone IN LISTS thermal_zones)
  if(IS_DIRECTORY "${zone}")
    set(zone_path "${zone}")
    if(IS_SYMLINK "${zone}")
      file(REAL_PATH "${zone}" resolved_zone)
      string(FIND "${resolved_zone}" "${thermal_sys_prefix}" resolved_index)
      if(NOT resolved_index EQUAL 0)
        continue()
      endif()
      set(zone_path "${resolved_zone}")
    endif()
    if(EXISTS "${zone_path}/type")
      file(READ "${zone_path}/type" zone_type)
      string(STRIP "${zone_type}" zone_type)
      if(zone_type STREQUAL "x86_pkg_temp")
        list(APPEND package_zones "${zone_path}")
      endif()
    endif()
  endif()
endforeach()
list(LENGTH package_zones package_zone_count)
if(NOT package_zone_count EQUAL 1)
  vss_fail("expected exactly one x86_pkg_temp thermal zone")
endif()
list(GET package_zones 0 package_zone)
vss_read("${package_zone}/temp" read_ok package_temp_millic)
