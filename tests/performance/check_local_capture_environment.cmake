function(vss_write_output result)
  if("${output}" STREQUAL "")
    message(FATAL_ERROR "VSS-MATH-PERF preflight output path is required")
  endif()
  get_filename_component(output_dir "${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_dir}")
  set(temp "${output}.tmp")
  file(WRITE "${temp}"
    "SCHEMA_VERSION=1\nRESULT=${result}\nHOST_PROFILE=${host_profile}\n"
    "RECORD_PROFILE=${record_profile}\nCONFIGURATION=${configuration}\n"
    "MATH_COMMIT=${math_commit}\nBENCHMARK_SHA256=${benchmark_sha}\n"
    "HOST_FINGERPRINT_SHA256=${host_fingerprint}\nOS_NAME=${os_name}\n"
    "ARCHITECTURE=${architecture}\nCPU_MODEL=${cpu_model}\n"
    "LOGICAL_CPU_COUNT=${logical_cpu_count}\nAFFINITY_CPU=${affinity_cpu}\n"
    "AFFINITY_SIBLINGS=${affinity_siblings}\nAC_ONLINE=${ac_online}\n"
    "BATTERY_STATUS=${battery_status}\nINTEL_PSTATE_MODE=${intel_pstate_mode}\n"
    "SCALING_GOVERNOR=${scaling_governor}\nINTEL_PSTATE_NO_TURBO=${intel_pstate_no_turbo}\n"
    "LOAD_1M=${load_1m}\nPACKAGE_TEMP_MILLIC=${package_temp_millic}\n"
    "MAX_LOAD_1M=${max_load_1m}\nMAX_PACKAGE_TEMP_MILLIC=${max_package_temp_millic}\n"
    "STABLE_WINDOW_SECONDS=${stable_window_seconds}\nSAMPLE_INTERVAL_SECONDS=${sample_interval_seconds}\n"
    "MAX_WAIT_SECONDS=${max_wait_seconds}\nSTART_UTC=${start_utc}\nEND_UTC=${end_utc}\n")
  file(RENAME "${temp}" "${output}" NO_REPLACE RESULT rename_status)
  if(NOT rename_status STREQUAL "0")
    file(REMOVE "${temp}")
    message(FATAL_ERROR "VSS-MATH-PERF preflight could not publish output: ${rename_status}")
  endif()
  file(REMOVE "${temp}")
  if(EXISTS "${temp}")
    message(FATAL_ERROR "VSS-MATH-PERF preflight could not remove temporary output")
  endif()
endfunction()

macro(vss_fail message_text)
  vss_write_output(preflight_failed)
  message(FATAL_ERROR "VSS-MATH-PERF qualification blocked: ${message_text}")
endmacro()

