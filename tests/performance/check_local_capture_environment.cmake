set(end_utc 1970-01-01T00:00:00Z)

function(vss_load_hundredths value out_ok out_value)
  if(NOT "${value}" MATCHES "^([0-9]+)(\\.([0-9][0-9]?))?$")
    set("${out_ok}" FALSE PARENT_SCOPE)
    set("${out_value}" 0 PARENT_SCOPE)
    return()
  endif()
  set(whole "${CMAKE_MATCH_1}")
  set(fraction "${CMAKE_MATCH_3}")
  if("${fraction}" STREQUAL "")
    set(fraction 00)
  elseif("${fraction}" MATCHES "^[0-9]$")
    set(fraction "${fraction}0")
  endif()
  string(LENGTH "${whole}" whole_length)
  if(whole_length GREATER 4)
    set("${out_ok}" FALSE PARENT_SCOPE)
    set("${out_value}" 0 PARENT_SCOPE)
    return()
  endif()
  math(EXPR hundredths "${whole} * 100 + ${fraction}")
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_value}" "${hundredths}" PARENT_SCOPE)
endfunction()

function(vss_evaluate_trace trace out_result out_reason)
  string(REPLACE ";" ";" rows "${trace}")
  set(window_count 0)
  set(last_elapsed -1)
  set(window_start -1)
  foreach(row IN LISTS rows)
    if(NOT row MATCHES "^([0-9]+)\\|([^|]+)\\|([0-9]+)\\|([^|]+)$")
      set("${out_result}" preflight_failed PARENT_SCOPE)
      set("${out_reason}" "sample trace is malformed" PARENT_SCOPE)
      return()
    endif()
    set(elapsed "${CMAKE_MATCH_1}")
    set(sample_load "${CMAKE_MATCH_2}")
    set(sample_temp "${CMAKE_MATCH_3}")
    set(sample_utc "${CMAKE_MATCH_4}")
    vss_load_hundredths("${sample_load}" load_ok load_value)
    if(NOT load_ok OR NOT sample_temp MATCHES "^[0-9]+$")
      set("${out_result}" preflight_failed PARENT_SCOPE)
      set("${out_reason}" "sample trace contains malformed load or temperature" PARENT_SCOPE)
      return()
    endif()
    if(elapsed GREATER VSS_PERF_MAX_WAIT_SECONDS)
      break()
    endif()
    set(load_1m "${sample_load}" PARENT_SCOPE)
    set(package_temp_millic "${sample_temp}" PARENT_SCOPE)
    set(end_utc "${sample_utc}" PARENT_SCOPE)
    if(load_value LESS_EQUAL 50 AND sample_temp LESS_EQUAL VSS_PERF_MAX_PACKAGE_TEMP_MILLIC)
      if(window_count EQUAL 0)
        set(window_count 1)
        set(window_start "${elapsed}")
      else()
        math(EXPR expected_elapsed "${window_start} + ${window_count} * ${VSS_PERF_SAMPLE_INTERVAL_SECONDS}")
        if(elapsed EQUAL expected_elapsed)
          math(EXPR window_count "${window_count} + 1")
        else()
          set(window_count 1)
          set(window_start "${elapsed}")
        endif()
      endif()
      if(window_count EQUAL 1)
        set(window_start "${elapsed}")
        set(start_utc "${sample_utc}" PARENT_SCOPE)
      endif()
      if(window_count GREATER_EQUAL 7)
        set("${out_result}" preflight_pass PARENT_SCOPE)
        set("${out_reason}" "" PARENT_SCOPE)
        return()
      endif()
    else()
      set(window_count 0)
    endif()
    set(last_elapsed "${elapsed}")
  endforeach()
  set("${out_result}" preflight_failed PARENT_SCOPE)
  set("${out_reason}" "no seven-sample stable window completed" PARENT_SCOPE)
endfunction()

if(DEFINED VSS_PERF_TEST_SAMPLE_TRACE AND NOT "${VSS_PERF_TEST_SAMPLE_TRACE}" STREQUAL "")
  vss_evaluate_trace("${VSS_PERF_TEST_SAMPLE_TRACE}" trace_result trace_reason)
else()
  set(window_count 0)
  string(TIMESTAMP current_utc UTC)
  set(start_utc "${current_utc}")
  set(end_utc "${current_utc}")
  set(trace_result preflight_failed)
  set(trace_reason "live sampling did not run")
  # The production loop is deliberately conservative and never changes host settings.
  string(TIMESTAMP start_epoch "%s" UTC)
  set(window_count 0)
  set(trace_reason "no seven-sample stable window completed before timeout")
  while(window_count LESS 7)
    string(TIMESTAMP current_epoch "%s" UTC)
    math(EXPR elapsed_seconds "${current_epoch} - ${start_epoch}")
    if(elapsed_seconds GREATER VSS_PERF_MAX_WAIT_SECONDS)
      break()
    endif()

    vss_host_path("proc/loadavg" load_path)
    vss_read("${load_path}" read_ok load_line)
    if(NOT read_ok OR NOT load_line MATCHES "^([0-9]+(\\.[0-9][0-9]?)?)")
      set(trace_reason "load average is missing or malformed")
      break()
    endif()
    set(sample_load "${CMAKE_MATCH_1}")
    vss_load_hundredths("${sample_load}" load_ok load_value)
    if(NOT load_ok)
      set(trace_reason "load average is oversized")
      break()
    endif()

    vss_read("${package_zone}/temp" read_ok sample_temperature)
    if(NOT read_ok OR NOT sample_temperature MATCHES "^[0-9]+$")
      set(trace_reason "package temperature is missing or malformed")
      break()
    endif()
    set(package_temp_millic "${sample_temperature}")
    set(load_1m "${sample_load}")

    if(load_value LESS_EQUAL 50 AND
       package_temp_millic LESS_EQUAL VSS_PERF_MAX_PACKAGE_TEMP_MILLIC)
      math(EXPR window_count "${window_count} + 1")
    else()
      set(window_count 0)
    endif()
    string(TIMESTAMP end_utc UTC)
    if(window_count GREATER_EQUAL 7)
      set(trace_result preflight_pass)
      break()
    endif()

    math(EXPR remaining_seconds
      "${VSS_PERF_MAX_WAIT_SECONDS} - ${elapsed_seconds}")
    if(remaining_seconds LESS_EQUAL 0)
      break()
    endif()
    if(remaining_seconds LESS VSS_PERF_SAMPLE_INTERVAL_SECONDS)
      set(sleep_seconds "${remaining_seconds}")
    else()
      set(sleep_seconds "${VSS_PERF_SAMPLE_INTERVAL_SECONDS}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep "${sleep_seconds}")
  endwhile()
endif()

if(NOT trace_result STREQUAL preflight_pass)
  vss_fail("${trace_reason}")
endif()
vss_write_output(preflight_pass)
message(STATUS "VSS-MATH-PERF qualification preflight passed for ${record_profile}")
