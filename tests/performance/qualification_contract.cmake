cmake_minimum_required(VERSION 3.28)

# Restricted, non-shell-evaluating readers shared by qualification scripts.
macro(vss_contract_set_failure out_ok out_reason reason)
  set("${out_ok}" FALSE PARENT_SCOPE)
  set("${out_reason}" "${reason}" PARENT_SCOPE)
endmacro()

function(vss_contract_read_kv path prefix expected out_ok out_reason)
  vss_contract_require_regular("${path}" "evidence file" regular_reason_ok regular_reason)
  if(NOT regular_reason_ok)
    vss_contract_set_failure("${out_ok}" "${out_reason}" "${regular_reason}")
    return()
  endif()
  file(READ "${path}" content)
  string(LENGTH "${content}" content_length)
  if(content_length LESS 1)
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "evidence file must not be empty: ${path}")
    return()
  endif()
  math(EXPR last_index "${content_length} - 1")
  string(SUBSTRING "${content}" ${last_index} 1 last_character)
  string(ASCII 10 newline_character)
  string(ASCII 13 carriage_return)
  string(FIND "${content}" "${carriage_return}" carriage_return_index)
  if(carriage_return_index GREATER -1 OR NOT last_character STREQUAL newline_character)
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "evidence file must use printable lines with a final newline: ${path}")
    return()
  endif()
  string(REPLACE "\n" ";" lines "${content}")
  list(POP_BACK lines)
  set(expected_keys "${expected}")
  list(LENGTH expected_keys expected_count)
  list(LENGTH lines actual_count)
  if(NOT actual_count EQUAL expected_count)
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${path}: expected ${expected_count} keys, got ${actual_count}")
    return()
  endif()
  set(index 0)
  foreach(line IN LISTS lines)
    if(line STREQUAL "" OR NOT line MATCHES "^([A-Z][A-Z0-9_]*)=(.*)$")
      vss_contract_set_failure("${out_ok}" "${out_reason}"
        "${path}: malformed key/value line")
      return()
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(value "${CMAKE_MATCH_2}")
    list(GET expected_keys ${index} expected_key)
    if(NOT key STREQUAL expected_key)
      vss_contract_set_failure("${out_ok}" "${out_reason}"
        "${path}: key order or duplicate mismatch at ${index}")
      return()
    endif()
    if(value MATCHES "[\r\n]" OR value MATCHES "[^ -~]")
      vss_contract_set_failure("${out_ok}" "${out_reason}"
        "${path}: value contains a forbidden character")
      return()
    endif()
    set("${prefix}_${key}" "${value}" PARENT_SCOPE)
    math(EXPR index "${index} + 1")
  endforeach()
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_contract_is_hex64 value out_ok)
  string(LENGTH "${value}" length)
  if(length EQUAL 64 AND "${value}" MATCHES "^[0-9a-f]+$")
    set("${out_ok}" TRUE PARENT_SCOPE)
  else()
    set("${out_ok}" FALSE PARENT_SCOPE)
  endif()
endfunction()

function(vss_contract_require_hex64 value label out_ok out_reason)
  vss_contract_is_hex64("${value}" valid)
  if(NOT valid)
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} must be lowercase SHA-256")
    return()
  endif()
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_contract_require_commit value label out_ok out_reason)
  string(LENGTH "${value}" length)
  if(NOT length EQUAL 40 OR NOT "${value}" MATCHES "^[0-9a-f]+$")
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} must be a lowercase 40-hex commit")
    return()
  endif()
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_contract_require_integer value label out_ok out_reason)
  if(NOT "${value}" MATCHES "^[0-9]+$")
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} must be an unsigned decimal integer")
    return()
  endif()
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_contract_require_utc value label out_ok out_reason)
  if(NOT "${value}" MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$")
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} must be UTC YYYY-MM-DDTHH:MM:SSZ")
    return()
  endif()
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_contract_utc_seconds value out_ok out_seconds out_reason)
  if(NOT "${value}" MATCHES
      "^([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])T([0-9][0-9]):([0-9][0-9]):([0-9][0-9])Z$")
    set("${out_ok}" FALSE PARENT_SCOPE)
    set("${out_seconds}" 0 PARENT_SCOPE)
    set("${out_reason}" "timestamp must be UTC YYYY-MM-DDTHH:MM:SSZ" PARENT_SCOPE)
    return()
  endif()
  set(year "${CMAKE_MATCH_1}")
  set(month "${CMAKE_MATCH_2}")
  set(day "${CMAKE_MATCH_3}")
  set(hour "${CMAKE_MATCH_4}")
  set(minute "${CMAKE_MATCH_5}")
  set(second "${CMAKE_MATCH_6}")
  foreach(number IN ITEMS year month day hour minute second)
    string(REGEX REPLACE "^0+([0-9])" "\\1" "${number}" "${${number}}")
  endforeach()
  if(year LESS 1 OR month LESS 1 OR month GREATER 12 OR day LESS 1 OR
     hour GREATER 23 OR minute GREATER 59 OR second GREATER 59)
    set("${out_ok}" FALSE PARENT_SCOPE)
    set("${out_seconds}" 0 PARENT_SCOPE)
    set("${out_reason}" "timestamp component is out of range" PARENT_SCOPE)
    return()
  endif()
  set(month_lengths 31 28 31 30 31 30 31 31 30 31 30 31)
  math(EXPR previous_year "${year} - 1")
  set(leap_year FALSE)
  math(EXPR divisible_by_four "${year} % 4")
  math(EXPR divisible_by_hundred "${year} % 100")
  math(EXPR divisible_by_four_hundred "${year} % 400")
  if(divisible_by_four EQUAL 0 AND
     (NOT divisible_by_hundred EQUAL 0 OR divisible_by_four_hundred EQUAL 0))
    set(leap_year TRUE)
  endif()
  if(leap_year AND month EQUAL 2)
    set(month_length 29)
  else()
    math(EXPR month_index "${month} - 1")
    list(GET month_lengths "${month_index}" month_length)
  endif()
  if(day GREATER month_length)
    set("${out_ok}" FALSE PARENT_SCOPE)
    set("${out_seconds}" 0 PARENT_SCOPE)
    set("${out_reason}" "timestamp day is invalid for its month" PARENT_SCOPE)
    return()
  endif()
  math(EXPR days "${previous_year} * 365 + ${previous_year} / 4 - ${previous_year} / 100 + ${previous_year} / 400")
  math(EXPR month_count "${month} - 1")
  if(month_count GREATER 0)
    math(EXPR last_month "${month_count} - 1")
    foreach(index RANGE 0 "${last_month}")
      list(GET month_lengths "${index}" month_days)
      if(index EQUAL 1 AND leap_year)
        math(EXPR month_days "${month_days} + 1")
      endif()
      math(EXPR days "${days} + ${month_days}")
    endforeach()
  endif()
  math(EXPR days "${days} + ${day} - 1")
  math(EXPR total_seconds "${days} * 86400 + ${hour} * 3600 + ${minute} * 60 + ${second}")
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_seconds}" "${total_seconds}" PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_contract_require_relative_path value label out_ok out_reason)
  if("${value}" STREQUAL "" OR "${value}" MATCHES "^/" OR
     "${value}" MATCHES "^[A-Za-z]:[\\\\/]" OR "${value}" MATCHES "\\\\" OR
     "${value}" MATCHES "(^|/)\\.\\.?(/|$)" OR "${value}" MATCHES "//" OR
     NOT "${value}" MATCHES "^[A-Za-z0-9._/-]+$")
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} is not a safe relative evidence path")
    return()
  endif()
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_contract_require_regular path label out_ok out_reason)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} must be a regular non-symlink file")
    return()
  endif()
  find_program(stat_program NAMES stat NO_CACHE)
  if(NOT stat_program)
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} cannot be checked as a regular file because stat is unavailable")
    return()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LC_ALL=C"
      "${stat_program}" --format=%F -- "${path}"
    RESULT_VARIABLE stat_status OUTPUT_VARIABLE stat_output ERROR_QUIET)
  if(NOT stat_status EQUAL 0)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LC_ALL=C"
        "${stat_program}" -f "%HT" "${path}"
      RESULT_VARIABLE stat_status OUTPUT_VARIABLE stat_output ERROR_QUIET)
  endif()
  string(STRIP "${stat_output}" stat_output)
  string(TOLOWER "${stat_output}" stat_output)
  if(NOT stat_status EQUAL 0 OR
     NOT stat_output MATCHES "^regular( empty)? file$")
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} must be a regular non-symlink file")
    return()
  endif()
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_contract_sha256 path out_hash)
  file(SHA256 "${path}" hash)
  set("${out_hash}" "${hash}" PARENT_SCOPE)
endfunction()

function(vss_contract_read_sha256 path expected label out_ok out_reason)
  vss_contract_require_regular("${path}" "${label}" regular reason)
  if(NOT regular)
    vss_contract_set_failure("${out_ok}" "${out_reason}" "${reason}")
    return()
  endif()
  vss_contract_sha256("${path}" actual)
  if(NOT actual STREQUAL expected)
    vss_contract_set_failure("${out_ok}" "${out_reason}"
      "${label} SHA-256 does not match its manifest")
    return()
  endif()
  set("${out_ok}" TRUE PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()
