cmake_minimum_required(VERSION 3.28)
include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/algorithm_record.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/qualification_contract.cmake")

set(_vss_algorithm_batch_case_ids
  tri.solve.n16.rhs4 tri.solve.n64.rhs4 tri.solve.n192.rhs4
  lu.factor.n16 lu.factor.n64 lu.factor.n128
  lu.solve.n16.rhs4 lu.solve.n64.rhs4 lu.solve.n128.rhs4
  qr_ls.factor.m32.n16 qr_ls.factor.m128.n64 qr_ls.factor.m256.n128
  qr_ls.solve.m32.n16.rhs4 qr_ls.solve.m128.n64.rhs4 qr_ls.solve.m256.n128.rhs4
  qr_square.factor.n192 qr_square.solve.n192.rhs4
  cholesky.factor.n16 cholesky.factor.n64 cholesky.factor.n128
  cholesky.solve.n16.rhs4 cholesky.solve.n64.rhs4 cholesky.solve.n128.rhs4
  eigen.decompose.n16 eigen.decompose.n64 eigen.decompose.n128
  covariance.propagate.j64x128.c128 differentiation.jacobian.in64.out128
  statistics.mean.n4096 statistics.population_variance.n4096
  statistics.sample_variance.n4096 statistics.population_stddev.n4096
  statistics.sample_stddev.n4096 statistics.rms.n4096
  probability.survival.n4096 probability.log_survival.n4096)

function(_vss_algorithm_batch_plan_keys out_keys)
  set(keys SCHEMA_VERSION RECORD_PROFILE CONFIGURATION MATH_COMMIT
    BENCHMARK_SHA256 CASE_COUNT)
  foreach(index RANGE 1 36)
    if(index LESS 10)
      set(number "0${index}")
    else()
      set(number "${index}")
    endif()
    list(APPEND keys "CASE_${number}_ID" "CASE_${number}_ITERATIONS")
  endforeach()
  set("${out_keys}" "${keys}" PARENT_SCOPE)
endfunction()

function(_vss_algorithm_batch_plan_candidate candidate_path out_json
    out_token out_reason)
  vss_algorithm_record_load("${candidate_path}" TRUE json token reason)
  if(NOT token STREQUAL "record_valid")
    set("${out_json}" "" PARENT_SCOPE)
    set("${out_token}" "${token}" PARENT_SCOPE)
    set("${out_reason}" "${reason}" PARENT_SCOPE)
    return()
  endif()
  _vss_algorithm_record_quality_validated("${json}" quality_token
    quality_reason)
  if(NOT quality_token STREQUAL "stable_pass")
    set("${out_json}" "" PARENT_SCOPE)
    set("${out_token}" "${quality_token}" PARENT_SCOPE)
    set("${out_reason}" "${quality_reason}" PARENT_SCOPE)
    return()
  endif()
  set("${out_json}" "${json}" PARENT_SCOPE)
  set("${out_token}" record_valid PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(_vss_algorithm_batch_plan_parse plan_path out_prefix out_token
    out_reason)
  vss_algorithm_regular_file("${plan_path}" plan_is_regular file_reason)
  if(NOT plan_is_regular)
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "${file_reason}" PARENT_SCOPE)
    return()
  endif()
  file(SIZE "${plan_path}" plan_size)
  if(plan_size GREATER 8192)
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "plan exceeds 8192 bytes" PARENT_SCOPE)
    return()
  endif()
  file(READ "${plan_path}" plan_hex HEX)
  if(NOT plan_hex MATCHES
      "^((0a|2[0-9a-f]|[3-6][0-9a-f]|7[0-9a-e]))*0a$")
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}"
      "plan must contain printable ASCII, use LF line endings, and end with LF"
      PARENT_SCOPE)
    return()
  endif()
  _vss_algorithm_batch_plan_keys(expected_keys)
  vss_contract_read_kv("${plan_path}" PARSED "${expected_keys}" keys_ok
    keys_reason)
  if(NOT keys_ok)
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "${keys_reason}" PARENT_SCOPE)
    return()
  endif()
  if(NOT PARSED_SCHEMA_VERSION STREQUAL "1" OR
     NOT PARSED_CASE_COUNT STREQUAL "36")
    set("${out_token}" incompatible PARENT_SCOPE)
    set("${out_reason}" "plan schema or case count is unsupported" PARENT_SCOPE)
    return()
  endif()
  if(NOT PARSED_RECORD_PROFILE MATCHES "^[a-z0-9][a-z0-9._-]*$")
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "plan record profile is malformed" PARENT_SCOPE)
    return()
  endif()
  if(NOT "${PARSED_CONFIGURATION}" MATCHES "^[A-Za-z0-9._-]+$")
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "plan configuration is malformed" PARENT_SCOPE)
    return()
  endif()
  vss_contract_require_commit("${PARSED_MATH_COMMIT}" "plan math commit"
    commit_ok commit_reason)
  vss_contract_require_hex64("${PARSED_BENCHMARK_SHA256}"
    "plan benchmark SHA-256" benchmark_sha_ok benchmark_sha_reason)
  if(NOT commit_ok OR NOT benchmark_sha_ok)
    set("${out_token}" invalid_record PARENT_SCOPE)
    if(NOT commit_ok)
      set("${out_reason}" "${commit_reason}" PARENT_SCOPE)
    else()
      set("${out_reason}" "${benchmark_sha_reason}" PARENT_SCOPE)
    endif()
    return()
  endif()

  foreach(index RANGE 1 36)
    if(index LESS 10)
      set(number "0${index}")
    else()
      set(number "${index}")
    endif()
    math(EXPR case_index "${index} - 1")
    list(GET _vss_algorithm_batch_case_ids "${case_index}" expected_id)
    if(NOT PARSED_CASE_${number}_ID STREQUAL expected_id)
      set("${out_token}" invalid_record PARENT_SCOPE)
      set("${out_reason}" "plan case ID or order differs at ${number}" PARENT_SCOPE)
      return()
    endif()
    if(NOT PARSED_CASE_${number}_ITERATIONS MATCHES "^(1|2|4|8|16|32|64|128|256|512|1024|2048|4096|8192|16384|32768|65536|131072|262144|524288|1048576)$")
      set("${out_token}" invalid_record PARENT_SCOPE)
      set("${out_reason}" "plan iteration count is invalid at ${number}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(key IN LISTS expected_keys)
    set("${out_prefix}_${key}" "${PARSED_${key}}" PARENT_SCOPE)
  endforeach()
  set("${out_token}" batch_plan_valid PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(_vss_algorithm_batch_plan_content candidate_json out_content
    out_token out_reason)
  string(JSON profile GET "${candidate_json}" profile_id)
  string(JSON environment GET "${candidate_json}" environment)
  string(JSON configuration GET "${environment}" configuration)
  if(NOT "${configuration}" MATCHES "^[A-Za-z0-9._-]+$")
    set("${out_content}" "" PARENT_SCOPE)
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "candidate configuration is malformed" PARENT_SCOPE)
    return()
  endif()
  string(JSON commit GET "${environment}" math_commit)
  string(JSON benchmark_sha GET "${environment}" benchmark_sha256)
  string(CONCAT content
    "SCHEMA_VERSION=1\nRECORD_PROFILE=${profile}\nCONFIGURATION=${configuration}\n"
    "MATH_COMMIT=${commit}\nBENCHMARK_SHA256=${benchmark_sha}\nCASE_COUNT=36\n")
  string(JSON case_count LENGTH "${candidate_json}" cases)
  if(NOT case_count EQUAL 36)
    set("${out_content}" "" PARENT_SCOPE)
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "candidate must contain exactly 36 cases" PARENT_SCOPE)
    return()
  endif()
  math(EXPR last_case "${case_count} - 1")
  foreach(index RANGE 0 "${last_case}")
    string(JSON item GET "${candidate_json}" cases "${index}")
    string(JSON case_id GET "${item}" case_id)
    string(JSON iterations GET "${item}" iterations_per_sample)
    list(GET _vss_algorithm_batch_case_ids "${index}" expected_id)
    if(NOT case_id STREQUAL expected_id)
      set("${out_content}" "" PARENT_SCOPE)
      set("${out_token}" invalid_record PARENT_SCOPE)
      set("${out_reason}" "candidate case order differs from frozen inventory" PARENT_SCOPE)
      return()
    endif()
    math(EXPR ordinal "${index} + 1")
    if(ordinal LESS 10)
      set(number "0${ordinal}")
    else()
      set(number "${ordinal}")
    endif()
    string(APPEND content
      "CASE_${number}_ID=${case_id}\nCASE_${number}_ITERATIONS=${iterations}\n")
  endforeach()
  string(LENGTH "${content}" content_length)
  if(content_length GREATER 8192)
    set("${out_content}" "" PARENT_SCOPE)
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "candidate-derived plan exceeds 8192 bytes" PARENT_SCOPE)
    return()
  endif()
  set("${out_content}" "${content}" PARENT_SCOPE)
  set("${out_token}" batch_plan_valid PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_algorithm_batch_plan_write candidate_path plan_path out_token
    out_reason)
  get_filename_component(parent_directory "${plan_path}" DIRECTORY)
  if(NOT IS_DIRECTORY "${parent_directory}")
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "plan destination parent is not a directory" PARENT_SCOPE)
    return()
  endif()
  set(temporary_path "${plan_path}.tmp")
  if(EXISTS "${plan_path}" OR IS_SYMLINK "${plan_path}")
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "plan destination already exists" PARENT_SCOPE)
    return()
  endif()
  if(EXISTS "${temporary_path}" OR IS_SYMLINK "${temporary_path}")
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "plan temporary already exists" PARENT_SCOPE)
    return()
  endif()

  _vss_algorithm_batch_plan_candidate("${candidate_path}" candidate_json
    candidate_token candidate_reason)
  if(NOT candidate_token STREQUAL "record_valid")
    set("${out_token}" "${candidate_token}" PARENT_SCOPE)
    set("${out_reason}" "${candidate_reason}" PARENT_SCOPE)
    return()
  endif()
  _vss_algorithm_batch_plan_content("${candidate_json}" content token reason)
  if(NOT token STREQUAL "batch_plan_valid")
    set("${out_token}" "${token}" PARENT_SCOPE)
    set("${out_reason}" "${reason}" PARENT_SCOPE)
    return()
  endif()

  file(WRITE "${temporary_path}" "${content}")
  file(RENAME "${temporary_path}" "${plan_path}" NO_REPLACE RESULT rename_result)
  if(NOT rename_result STREQUAL "0")
    file(REMOVE "${temporary_path}")
    set("${out_token}" invalid_record PARENT_SCOPE)
    set("${out_reason}" "atomic plan publication failed: ${rename_result}" PARENT_SCOPE)
    return()
  endif()
  set("${out_token}" batch_plan_valid PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()

function(vss_algorithm_batch_plan_validate plan_path candidate_path out_token
    out_reason)
  _vss_algorithm_batch_plan_parse("${plan_path}" PLAN parsed_token
    parsed_reason)
  if(NOT parsed_token STREQUAL "batch_plan_valid")
    set("${out_token}" "${parsed_token}" PARENT_SCOPE)
    set("${out_reason}" "${parsed_reason}" PARENT_SCOPE)
    return()
  endif()
  _vss_algorithm_batch_plan_candidate("${candidate_path}" candidate_json
    candidate_token candidate_reason)
  if(NOT candidate_token STREQUAL "record_valid")
    set("${out_token}" "${candidate_token}" PARENT_SCOPE)
    set("${out_reason}" "${candidate_reason}" PARENT_SCOPE)
    return()
  endif()
  string(JSON profile GET "${candidate_json}" profile_id)
  string(JSON environment GET "${candidate_json}" environment)
  string(JSON configuration GET "${environment}" configuration)
  string(JSON commit GET "${environment}" math_commit)
  string(JSON benchmark_sha GET "${environment}" benchmark_sha256)
  foreach(pair IN ITEMS
      "RECORD_PROFILE|${profile}"
      "CONFIGURATION|${configuration}"
      "MATH_COMMIT|${commit}"
      "BENCHMARK_SHA256|${benchmark_sha}")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 key)
    list(GET fields 1 expected)
    if(NOT "${PLAN_${key}}" STREQUAL "${expected}")
      set("${out_token}" incompatible PARENT_SCOPE)
      set("${out_reason}" "plan identity differs at ${key}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  math(EXPR last_case "36 - 1")
  foreach(index RANGE 0 "${last_case}")
    math(EXPR ordinal "${index} + 1")
    if(ordinal LESS 10)
      set(number "0${ordinal}")
    else()
      set(number "${ordinal}")
    endif()
    string(JSON item GET "${candidate_json}" cases "${index}")
    string(JSON candidate_iterations GET "${item}" iterations_per_sample)
    if(NOT PLAN_CASE_${number}_ITERATIONS STREQUAL candidate_iterations)
      set("${out_token}" incompatible PARENT_SCOPE)
      set("${out_reason}" "plan iteration count differs from candidate at ${number}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set("${out_token}" batch_plan_valid PARENT_SCOPE)
  set("${out_reason}" "" PARENT_SCOPE)
endfunction()
