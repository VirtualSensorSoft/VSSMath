cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED VSS_PERF_BASELINE OR NOT IS_ABSOLUTE "${VSS_PERF_BASELINE}")
  message(FATAL_ERROR "VSS_PERF_BASELINE must be an absolute path")
endif()
if(NOT DEFINED VSS_PERF_CURRENT OR NOT IS_ABSOLUTE "${VSS_PERF_CURRENT}")
  message(FATAL_ERROR "VSS_PERF_CURRENT must be an absolute path")
endif()
if(NOT DEFINED VSS_PERF_MAX_PERCENT
   OR NOT "${VSS_PERF_MAX_PERCENT}" MATCHES "^[0-9]+$")
  message(FATAL_ERROR "VSS_PERF_MAX_PERCENT must be a non-negative integer")
endif()
if(NOT EXISTS "${VSS_PERF_BASELINE}")
  message(FATAL_ERROR "baseline file does not exist: ${VSS_PERF_BASELINE}")
endif()
if(NOT EXISTS "${VSS_PERF_CURRENT}")
  message(FATAL_ERROR "current file does not exist: ${VSS_PERF_CURRENT}")
endif()

function(vss_perf_read_env path prefix)
  file(STRINGS "${path}" lines)
  set(keys)
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "\r$" "" line "${line}")
    if(NOT line MATCHES "^([A-Za-z0-9_]+)=(.*)$")
      message(FATAL_ERROR "invalid line in ${path}: ${line}")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(value "${CMAKE_MATCH_2}")
    list(FIND keys "${key}" key_index)
    if(NOT key_index EQUAL -1)
      message(FATAL_ERROR "duplicate key ${key} in ${path}")
    endif()
    list(APPEND keys "${key}")
    set("${prefix}_${key}" "${value}" PARENT_SCOPE)
  endforeach()
  set("${prefix}_keys" "${keys}" PARENT_SCOPE)
endfunction()

vss_perf_read_env("${VSS_PERF_BASELINE}" baseline)
vss_perf_read_env("${VSS_PERF_CURRENT}" current)

set(required_metadata
  schema os cpu compiler build_type compiler_options command seed warmups measurements)
foreach(key IN LISTS required_metadata)
  list(FIND baseline_keys "${key}" baseline_index)
  list(FIND current_keys "${key}" current_index)
  if(baseline_index EQUAL -1 OR current_index EQUAL -1)
    message(FATAL_ERROR "missing required key ${key}")
  endif()
  set(baseline_var "baseline_${key}")
  set(current_var "current_${key}")
  if(NOT "${${baseline_var}}" STREQUAL "${${current_var}}")
    message(FATAL_ERROR
      "incompatible metadata ${key}: baseline='${${baseline_var}}' current='${${current_var}}'")
  endif()
endforeach()

set(baseline_timing)
set(current_timing)
foreach(key IN LISTS baseline_keys)
  if(key MATCHES "_ns$")
    list(APPEND baseline_timing "${key}")
  elseif(key MATCHES "_allocations$")
    # Allocation keys are paired and checked below.
  elseif(key STREQUAL "checksum")
    # Checksum is informational and is not a compatibility discriminator.
  elseif(NOT key IN_LIST required_metadata)
    message(FATAL_ERROR "unknown key ${key} in baseline file")
  endif()
endforeach()
foreach(key IN LISTS current_keys)
  if(key MATCHES "_ns$")
    list(APPEND current_timing "${key}")
  elseif(key MATCHES "_allocations$")
    # Allocation keys are paired and checked below.
  elseif(key STREQUAL "checksum")
    # Checksum is informational and is not a compatibility discriminator.
  elseif(NOT key IN_LIST required_metadata)
    message(FATAL_ERROR "unknown key ${key} in current file")
  endif()
endforeach()
list(SORT baseline_timing)
list(SORT current_timing)
if(NOT baseline_timing STREQUAL current_timing)
  message(FATAL_ERROR "incompatible timing metric keys")
endif()
if(NOT baseline_timing)
  message(FATAL_ERROR "no timing metrics found")
endif()

foreach(timing_key IN LISTS baseline_timing)
  string(REGEX REPLACE "_ns$" "" metric "${timing_key}")
  set(allocation_key "${metric}_allocations")
  list(FIND baseline_keys "${allocation_key}" baseline_allocation_index)
  list(FIND current_keys "${allocation_key}" current_allocation_index)
  if(baseline_allocation_index EQUAL -1 OR current_allocation_index EQUAL -1)
    message(FATAL_ERROR "missing allocation metric ${allocation_key}")
  endif()

  set(baseline_timing_var "baseline_${timing_key}")
  set(current_timing_var "current_${timing_key}")
  set(baseline_allocation_var "baseline_${allocation_key}")
  set(current_allocation_var "current_${allocation_key}")
  foreach(value_name IN ITEMS "${baseline_timing_var}" "${current_timing_var}"
          "${baseline_allocation_var}" "${current_allocation_var}")
    if(NOT "${${value_name}}" MATCHES "^[0-9]+$")
      message(FATAL_ERROR "metric ${value_name} is not a non-negative integer")
    endif()
  endforeach()

  math(EXPR timing_limit "${${baseline_timing_var}} * ${VSS_PERF_MAX_PERCENT}")
  math(EXPR current_timing_scaled "${${current_timing_var}} * 100")
  if(current_timing_scaled GREATER timing_limit)
    message(FATAL_ERROR
      "${timing_key}: current=${${current_timing_var}}ns exceeds baseline=${${baseline_timing_var}}ns at ${VSS_PERF_MAX_PERCENT}%")
  endif()
  if(${${current_allocation_var}} GREATER ${${baseline_allocation_var}})
    message(FATAL_ERROR
      "${allocation_key}: current=${${current_allocation_var}} exceeds baseline=${${baseline_allocation_var}}")
  endif()
endforeach()

message(STATUS "performance regression check passed")
